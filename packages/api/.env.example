DATABASE_URL=postgresql://user:pass@localhost:5432/flyby
REDIS_URL=redis://localhost:6379
PORT=3001
NODE_ENV=development

# Admin API key for DELETE /api/reports/:id (QA test-record cleanup).
# Generate with: openssl rand -hex 32
# Required in production - if unset, report deletion is disabled (503).
ADMIN_API_KEY=change-me-generate-a-random-secret
