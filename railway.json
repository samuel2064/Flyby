{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --include=dev && npx prisma generate --schema packages/api/prisma/deploy/schema.postgres.prisma && npm run build --workspace=@flyby/api"
  },
  "deploy": {
    "preDeployCommand": "npx prisma migrate deploy --schema packages/api/prisma/deploy/schema.postgres.prisma",
    "startCommand": "node packages/api/dist/server.js",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
