// Prisma schema for Flyby API
// Defines the database structure for the application

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// Crowdsourced wait-time reports. Persisted so data survives restarts (TIR-281).
model WaitTimeReport {
  id          String   @id
  airport     String
  checkpoint  String
  waitMinutes Int
  reporter    String?
  createdAt   DateTime @default(now())

  // Moderation (TIR-325): durable abuse-flag state for the review queue.
  // moderationStatus: 'none' (default) | 'flagged' (awaiting review) |
  // 'hidden' (moderator-removed from public surfaces until cleared).
  flaggedAt        DateTime?
  flagReason       String?
  moderationStatus String   @default("none")

  flags ReportFlag[]

  @@index([airport])
  @@index([createdAt])
  @@index([moderationStatus])
}

// Push-notification subscriptions. Idempotent per endpoint+airportId (QA contract).
model NotificationSubscription {
  id          String   @id
  endpoint    String
  p256dh      String
  auth        String
  airportId   String
  airportCode String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([endpoint, airportId])
  @@index([userId])
}

// Per-user notification preferences (QA contract: dnd/threshold/frequency fields).
model UserPreference {
  userId           String   @id
  enabled          Boolean  @default(true)
  dndStart         String
  dndEnd           String
  thresholdMinutes Int
  frequency        String
  updatedAt        DateTime @updatedAt
}

// Crowdsourced trust flags (TIR-337 / TIR-324): one row per
// (reportId, sessionId) so repeat flags from the same session count once.
// A report reaching FLAG_HIDE_THRESHOLD distinct sessions is hidden from all
// public surfaces (wait-times, wait-stats, summary).
model ReportFlag {
  id        Int            @id @default(autoincrement())
  reportId  String
  sessionId String
  reason    String?
  createdAt DateTime       @default(now())
  report    WaitTimeReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, sessionId])
  @@index([reportId])
}
