// Dev container for GitHub Codespaces / VS Code Dev Containers.
//
// One-click setup for the full Flyby dev stack: this boots the existing
// docker-compose.yml (PostgreSQL 16 + API) inside the Codespace, then
// applies Prisma migrations automatically.
//
// Usage in GitHub: repo -> <> Code -> Codespaces -> Create codespace on main.
// Docker Engine + Compose v2 are preinstalled in every Codespace, so this
// replaces the blocked local Docker Desktop setup (TIR-187 chain).
{
  "name": "Flyby Dev (Postgres + API)",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "api",
  "workspaceFolder": "/app",
  "remoteEnv": {
    "COMPOSE_PROJECT_NAME": "flyby"
  },
  
  // Remove updateContentCommand - let devcontainer handle compose startup
  // "updateContentCommand": "docker compose --env-file ../.env.docker up -d --build",
  
  // This runs AFTER the devcontainer is created/started
  "postCreateCommand": "docker compose --env-file ../.env.docker up -d --build && docker compose --env-file ../.env.docker exec -T api sh -c 'for i in {1..30}; do node -e \"fetch(\\\"http://localhost:3000/api/health\\\").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\" && break || sleep 2; done && npx prisma migrate deploy'",
  
  "forwardPorts": [3000, 5432],
  "portsAttributes": {
    "3000": { "label": "Flyby API", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Prisma.prisma", "dbaeumer.vscode-eslint"]
    }
  },
  "remoteUser": "nextjs"
}
