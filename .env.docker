# Local Docker Compose environment for Flyby development.
#
# Used by docker-compose.yml (env_file). These values are safe to commit:
# they are local-dev-only defaults. Production secrets are injected by
# Render (see render.yaml -> generateValue / fromDatabase).
#
# To override any value locally, copy this file to .env.docker.local and
# edit there, or export the var in your shell — docker-compose precedence:
#   shell env > .env file > compose env_file > compose `environment:`.
#
# DATABASE_URL points at the `postgres` service hostname (容器内 networking),
# which is only reachable from inside the compose network. For host-side
# tooling (e.g. running prisma from your laptop), use localhost:5432 instead.

# --- Database (PostgreSQL 16, matches Render) ---
POSTGRES_USER=flyby
POSTGRES_PASSWORD=flyby
POSTGRES_DB=flyby
DATABASE_URL=postgresql://flyby:flyby@postgres:5432/flyby

# --- App runtime ---
NODE_ENV=development
PORT=3000

# --- Auth (dev placeholder only — never use in production) ---
JWT_SECRET=dev-only-jwt-secret-change-me

# --- Misc dev vars (extend as the app grows) ---
# LOG_LEVEL=debug
# SSE_HEARTBEAT_MS=25000
